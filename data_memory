module data_memory(
    input         clk,
    input         MemWrite, // 1 permite guardar un dato en memoria
    input  [31:0] A,        // Dirección de memoria (Resultado de la ALU)
    input  [31:0] WD,       // Dato que se va a guardar (Write Data)
    output [31:0] RD        // Dato que se lee de la memoria (Read Data)
);
    reg [31:0] ram [0:63]; // Memoria pequeña de 64 registros para pruebas

    always @(posedge clk) begin
        if (MemWrite) begin
            ram[A[31:2]] <= WD; // Guarda usando alineación de palabras
        end
    end

    assign RD = ram[A[31:2]]; // Lectura continua
endmodule
