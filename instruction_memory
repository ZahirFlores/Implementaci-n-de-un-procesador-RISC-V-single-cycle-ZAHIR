module instruction_memory( 
	input             clk,
	input      [31:0] A,        // Dirección que viene del PC
	output reg [31:0] RD        // Instrucción de 32 bits leída
);

	reg [31:0] instr_mem [0:2]; // Arreglo de memoria con 3 espacios (0, 1 y 2)
	
	initial begin
        // Lee el archivo de texto y carga los valores en el arreglo
		$readmemh("instrMem.hex", instr_mem);
		$display("instr_mem[0] = %h", instr_mem[0]);
		$display("instr_mem[1] = %h", instr_mem[1]);
		$display("instr_mem[2] = %h", instr_mem[2]);
	end
	
	always @(posedge clk) begin
        // Divide la dirección entre 4 usando bits [31:2] para alineación de palabras
		RD <= instr_mem[A[31:2]];
    end
endmodule
