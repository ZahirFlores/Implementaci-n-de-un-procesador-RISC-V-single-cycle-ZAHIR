module control_unit(
    input      [6:0] op,         // Opcode de la instrucción
    output reg       RegWrite,   // Habilita escritura en el banco de registros
    output reg [1:0] ImmSrc,     // Tipo de extensión para el inmediato
    output reg       ALUSrc,     // Elige si la ALU opera con registro o inmediato
    output reg       MemWrite,   // Habilita escritura en la RAM
    output reg [1:0] ResultSrc,  // Selecciona el origen del dato que va a los registros
    output reg       Branch,     // Indica una instrucción beq
    output reg [1:0] ALUOp,      // Código de operación base para la ALU Control
    output reg       Jump        // Indica una instrucción jal
);

    always @(*) begin
        // Valores por defecto (estado seguro)
        RegWrite  = 1'b0; ImmSrc    = 2'b00; ALUSrc    = 1'b0; MemWrite  = 1'b0;
        ResultSrc = 2'b00; Branch    = 1'b0; ALUOp     = 2'b00; Jump      = 1'b0;

        case (op)
            7'b0000011: begin // lw
                RegWrite = 1'b1; ImmSrc = 2'b00; ALUSrc = 1'b1; ResultSrc = 2'b01;
            end
            7'b0100011: begin // sw
                ImmSrc = 2'b01; ALUSrc = 1'b1; MemWrite = 1'b1;
            end
            7'b0110011: begin // Tipo-R (add)
                RegWrite = 1'b1; ALUOp = 2'b10;
            end
            7'b1100011: begin // beq
                ImmSrc = 2'b10; Branch = 1'b1; ALUOp = 2'b01;
            end
            7'b0010011: begin // Tipo-I (addi)
                RegWrite = 1'b1; ImmSrc = 2'b00; ALUSrc = 1'b1; ALUOp = 2'b10;
            end
            7'b1101111: begin // jal
                RegWrite = 1'b1; ImmSrc = 2'b11; ResultSrc = 2'b10; Jump = 1'b1;
            end
        endcase
    end
endmodule
